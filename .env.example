# ==============================================================================
# Inclusive AI Tutor - Environment Configuration
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# LLM Provider Configuration
# Supported options: "gemini", "openai", "ollama", "fallback"
# Defaults to "fallback" for 100% offline functionality without API keys
LLM_PROVIDER=fallback

# API Keys (Optional if LLM_PROVIDER=fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Configuration (if running locally: e.g. ollama run llama3.2:3b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# RAG & Embedding Settings
# Provider options: "scikit" (default, lightweight offline TF-IDF/Dense), "sentence_transformers", "faiss"
EMBEDDING_PROVIDER=scikit
EMBEDDING_MODEL=all-MiniLM-L6-v2
DATA_DIR=backend/app/data/curriculum

# Persistence
PERSISTENCE_MODE=in_memory
MONGODB_URI=
